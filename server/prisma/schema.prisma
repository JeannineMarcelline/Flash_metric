// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}


datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())   
  nom        String
  prenom     String
  email      String   @unique
  telephone  String
  password   String?  // "?" signifie pas obligatoire
  createdAt  DateTime @default(now()) // pour savoir quand il s'est inscrit
  websites    Website[]
}

model Website {
  id          Int        @id @default(autoincrement())
  url         String
  name        String
  active      Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id])
  userId      Int
  metrics     Metric[]    //une site peut avoir plusieurs resultat de test
 }

 model Metric {
  id                Int        @id @default(autoincrement())
  tempsReponse      Int
  statut            Int
  createdAt         DateTime   @default(now())
  websiteId         Int
  website           Website    @relation(fields: [websiteId], references: [id])
 }